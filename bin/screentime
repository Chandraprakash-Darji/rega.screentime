#!/usr/bin/env python3
"""Native screen-time tracker CLI for the rega.screentime Omarchy plugin.

Why native: activitywatch-bin is x86_64-only, this host is aarch64
(Apple Silicon), so ActivityWatch can't run here. This tracks unlocked
screen time via Hyprland active-window polling instead. Local-only.

Storage: ~/.local/share/omarchy/screentime/days/YYYY-MM-DD.json
  {"date": "2026-09-11", "total": 12345, "samples": 823,
   "apps": {"kitty": 3600, "chromium": 1800},
   "tabs": {"GitHub - Chromium": 600}}

Usage:
    screentime tick [--interval 15]   # record one sample (called by panel timer)
    screentime status [--shell|--json] # summary for panel / terminal
    screentime week [--json]           # last 7 days totals
"""

import argparse
import datetime
import json
import os
import subprocess
import sys

DATA_DIR = os.path.join(os.path.expanduser("~"), ".local", "share", "omarchy", "screentime")
DAYS_DIR = os.path.join(DATA_DIR, "days")
BROWSERS = {"chromium", "chrome", "google-chrome", "firefox", "zen", "zen-browser",
            "brave", "brave-browser", "edge", "microsoft-edge", "safari", "arc"}


def ensure_dirs():
    os.makedirs(DAYS_DIR, exist_ok=True)


def day_path(d):
    return os.path.join(DAYS_DIR, d.isoformat() + ".json")


def load_day(d):
    p = day_path(d)
    base = {"date": d.isoformat(), "total": 0, "samples": 0, "apps": {}, "tabs": {}}
    if not os.path.exists(p):
        return base
    try:
        with open(p, encoding="utf-8") as f:
            data = json.load(f)
        base["total"] = int(data.get("total", 0))
        base["samples"] = int(data.get("samples", 0))
        if isinstance(data.get("apps"), dict):
            base["apps"] = {str(k): int(v) for k, v in data["apps"].items()}
        if isinstance(data.get("tabs"), dict):
            base["tabs"] = {str(k): int(v) for k, v in data["tabs"].items()}
    except (json.JSONDecodeError, OSError, ValueError):
        pass
    return base


def save_day(entry):
    ensure_dirs()
    tmp = day_path(datetime.date.fromisoformat(entry["date"])) + ".tmp"
    with open(tmp, "w", encoding="utf-8") as f:
        json.dump(entry, f)
    os.replace(tmp, day_path(datetime.date.fromisoformat(entry["date"])))


def is_locked():
    """True when the screen is locked (don't count)."""
    try:
        r = subprocess.run(["pgrep", "-x", "hyprlock"], capture_output=True, timeout=3)
        return r.returncode == 0
    except (OSError, subprocess.SubprocessError):
        return False


def active_window():
    """Returns (app_class, title). Empty strings when unknown."""
    try:
        r = subprocess.run(["hyprctl", "activewindow", "-j"],
                           capture_output=True, text=True, timeout=5)
        if r.returncode != 0 or not r.stdout.strip():
            return ("", "")
        data = json.loads(r.stdout)
        cls = str(data.get("class") or data.get("initialClass") or "").strip()
        title = str(data.get("title") or data.get("initialTitle") or "").strip()
        return (cls, title)
    except (OSError, subprocess.SubprocessError, json.JSONDecodeError, ValueError):
        return ("", "")


def cmd_tick(interval):
    if is_locked():
        return 0
    cls, title = active_window()
    today = datetime.date.today()
    entry = load_day(today)
    entry["total"] += interval
    entry["samples"] += 1
    app = cls if cls else "Desktop"
    entry["apps"][app] = int(entry["apps"].get(app, 0)) + interval
    if cls.lower() in BROWSERS and title:
        tab = title[:80]
        entry["tabs"][tab] = int(entry["tabs"].get(tab, 0)) + interval
    save_day(entry)
    return 0


def fmt_dur(sec):
    sec = int(sec)
    if sec < 60:
        return "%ds" % sec
    m = sec // 60
    if m < 60:
        return "%dm" % m
    h = m // 60
    rem = m % 60
    if rem == 0:
        return "%dh" % h
    return "%dh %dm" % (h, rem)


def week_entries():
    today = datetime.date.today()
    out = []
    for i in range(6, -1, -1):
        d = today - datetime.timedelta(days=i)
        out.append(load_day(d))
    return out


def summary():
    today = datetime.date.today()
    t = load_day(today)
    week = week_entries()
    week_total = sum(e["total"] for e in week)
    top_apps = sorted(t["apps"].items(), key=lambda kv: kv[1], reverse=True)[:5]
    top_tabs = sorted(t["tabs"].items(), key=lambda kv: kv[1], reverse=True)[:3]
    return {
        "date": today.isoformat(),
        "total_sec": t["total"],
        "total": fmt_dur(t["total"]),
        "samples": t["samples"],
        "week_total_sec": week_total,
        "week_total": fmt_dur(week_total),
        "week": [{"date": e["date"], "total_sec": e["total"],
                  "total": fmt_dur(e["total"])} for e in week],
        "top_apps": [{"name": n, "sec": s, "time": fmt_dur(s)} for n, s in top_apps],
        "top_tabs": [{"name": n, "sec": s, "time": fmt_dur(s)} for n, s in top_tabs],
        "tracking": True,
        "note": "counts unlocked screen time (15s samples)",
    }


def cmd_status(shell, as_json):
    s = summary()
    if as_json:
        print(json.dumps(s))
        return 0
    if shell:
        # tab-separated for Model.parseKeyValue (no arrays — panel refetches json for lists)
        print("total\t%s" % s["total"])
        print("total_sec\t%d" % s["total_sec"])
        print("week_total\t%s" % s["week_total"])
        if s["top_apps"]:
            print("top_app\t%s" % s["top_apps"][0]["name"])
            print("top_app_time\t%s" % s["top_apps"][0]["time"])
        return 0
    print("Today: %s (%d samples)" % (s["total"], s["samples"]))
    print("Week:  %s" % s["week_total"])
    print("Top apps:")
    for a in s["top_apps"]:
        print("  %-22s %s" % (a["name"][:22], a["time"]))
    if s["top_tabs"]:
        print("Top tabs:")
        for t in s["top_tabs"]:
            print("  %-22s %s" % (t["name"][:22], t["time"]))
    return 0


def main(argv=None):
    ap = argparse.ArgumentParser(prog="screentime")
    sub = ap.add_subparsers(dest="cmd", required=True)
    p_tick = sub.add_parser("tick")
    p_tick.add_argument("--interval", type=int, default=15)
    p_status = sub.add_parser("status")
    p_status.add_argument("--shell", action="store_true")
    p_status.add_argument("--json", action="store_true")
    p_week = sub.add_parser("week")
    p_week.add_argument("--json", action="store_true")
    args = ap.parse_args(argv)
    if args.cmd == "tick":
        return cmd_tick(max(1, args.interval))
    if args.cmd == "status":
        return cmd_status(args.shell, args.json)
    if args.cmd == "week":
        w = week_entries()
        if args.json:
            print(json.dumps([{"date": e["date"], "total_sec": e["total"]} for e in w]))
        else:
            for e in w:
                print("%s  %s" % (e["date"], fmt_dur(e["total"])))
        return 0
    return 2


if __name__ == "__main__":
    sys.exit(main())
